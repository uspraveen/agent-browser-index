# LLM provider keys
FIREWORKS_API_KEY=
# Escalation/frontier brain (grok-4.6 on xAI). Without a key the escalation
# tier degrades to the base brain (longer timeout, bigger token budget).
XAI_API_KEY=
ESCALATION_MODEL=grok-4.6
FIREWORKS_TEMPERATURE=0.2
# Headroom for reasoning-style models (GLM/Kimi emit thinking before the action
# JSON — reasoning tokens count toward max_tokens). Timeouts are env-tunable too.
# FAST = base brain budget/timeouts; SLOW = escalation brain budget/timeouts.
FIREWORKS_FAST_TIMEOUT_MS=30000
FIREWORKS_SLOW_TIMEOUT_MS=90000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash
GEMINI_MEDIUM_MODEL=gemini-3.5-flash
GEMINI_SLOW_MODEL=gemini-3.5-flash

# Default base brain: GLM 5.3 Flash on Fireworks (1040k context, function calling).
# Leave unset to use the built-in default. Kimi K2.6 opt-in as base:
#   FIREWORKS_DEFAULT_MODEL=accounts/fireworks/models/kimi-k2p6
# FIREWORKS_DEFAULT_MODEL=
FIREWORKS_FAST_MAX_TOKENS=2048
FIREWORKS_SLOW_MAX_TOKENS=4096

# Summary compression LLM. GPT-5.6 Luna (fast, high thinking) is the default.
# Fireworks GLM alternative: SUMMARY_LLM_PROVIDER=fireworks_kimi
#   SUMMARY_LLM_MODEL=accounts/fireworks/models/glm-5p3-flash
SUMMARY_LLM_PROVIDER=openai
SUMMARY_LLM_MODEL=gpt-5.6-luna
SUMMARY_LLM_REASONING_EFFORT=high
SUMMARY_LLM_TEMPERATURE=0.1
SUMMARY_LLM_MAX_TOKENS=900

# MiMo grounding server
MIMO_API_URL=https://uspraveenraj--mimo-vl-7b-rl-serve.modal.run
MIMO_API_KEY=
MIMO_MAX_TOKENS=128
MIMO_TEMPERATURE=0
MIMO_TIMEOUT=12
MIMO_HTTP2=true
BROWSER_TYPE_DELAY_MS=10

# COSMIC Browser Memory
SUPERMEMORY_API_KEY=
COSMIC_MEMORY_MODE=off
COSMIC_MEMORY_DIR=./data/cosmic_memory
COSMIC_USER_ID=demo_user
COSMIC_CONTAINER_TAG=cosmic-hackathon-demo
COSMIC_REPLAY_MAX_ACTIONS=8
COSMIC_INTERACTION_MODE=hybrid

# LLM run indexer. Distills noisy run logs into gold-path workflows.
COSMIC_INDEXER_ENABLED=true
COSMIC_INDEXER_PROVIDER=fireworks_kimi
COSMIC_INDEXER_MODEL=accounts/fireworks/models/glm-5p3-flash
COSMIC_INDEXER_TEMPERATURE=0.1
COSMIC_INDEXER_MAX_TOKENS=4096
COSMIC_INDEXER_TIMEOUT=90

VISIBLE_ANSWER_GOVERNOR_ENABLED=true
VISIBLE_ANSWER_GOVERNOR_MIN_STEP=12
VISIBLE_ANSWER_GOVERNOR_WINDOW=4
VISIBLE_ANSWER_GOVERNOR_COOLDOWN_STEPS=2
VISIBLE_ANSWER_GOVERNOR_MIN_PROGRESS=0.65
SEARCH_RESULTS_GOVERNOR_ENABLED=true
SEARCH_RESULTS_GOVERNOR_MIN_STEP=8
SEARCH_RESULTS_GOVERNOR_WINDOW=6
SEARCH_RESULTS_GOVERNOR_COOLDOWN_STEPS=4
