# Copy to .env and fill in. Never commit .env.

# If this file was ever committed with a real key, rotate the key in the AgentPhone dashboard.

AGENTPHONE_API_KEY=

# After running provision.py, paste the signing secret from the webhook response:
AGENTPHONE_WEBHOOK_SECRET=

# Public base URL (HTTPS) where this app is reachable, no trailing slash.
# Example: https://abcd-12-34-56-78.ngrok-free.app
WEBHOOK_PUBLIC_BASE=

# Optional: E.164 number already on this project (provision attaches it to the demo agent if unassigned)
AGENTPHONE_PHONE_NUMBER=

# Optional defaults for send_sms.py
AGENTPHONE_AGENT_ID=
AGENTPHONE_NUMBER_ID=
